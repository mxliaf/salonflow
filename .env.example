# =============================================================================
# SalonFlow — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# =============================================================================

# --- SECRET_KEY (OBRIGATÓRIO) ---
# Chave secreta para assinatura de tokens JWT.
# Gere uma com: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=

# --- Banco de Dados (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://salonflow:salonflow@db:5432/salonflow

POSTGRES_USER=salonflow
POSTGRES_PASSWORD=salonflow
POSTGRES_DB=salonflow

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:4321

# --- Horário de Funcionamento do Salão ---
SALON_OPEN_TIME=08:00
SALON_CLOSE_TIME=18:00
