---
// Navbar.astro
---

<header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/70 backdrop-blur-md border-b border-slate-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-brand-600 to-pink-500 shadow-lg shadow-brand-500/20">
          <span class="text-xl font-bold text-white">S</span>
        </div>
        <span class="text-2xl font-extrabold tracking-tight text-white">
          Salon<span class="bg-gradient-to-r from-brand-400 to-pink-400 bg-clip-text text-transparent">Flow</span>
        </span>
      </div>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#servicos" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Serviços</a>
        <a href="#precos" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Preços</a>
        <a href="#depoimentos" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Avaliações</a>
        <a href="#contato" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Contato</a>
      </nav>

      <!-- CTA -->
      <div>
        <a
          href="http://localhost:3000/login"
          class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-brand-600 to-pink-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 hover:from-brand-500 hover:to-pink-500 transition-all hover:scale-[1.03] active:scale-[0.98]"
        >
          Entrar no App
        </a>
      </div>
    </div>
  </div>
</header>
