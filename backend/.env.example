# URL do Banco de Dados (PostgreSQL via asyncpg em prod/docker ou SQLite para testes locais)
# Exemplo PostgreSQL: postgresql+asyncpg://usuario:senha@localhost:5432/salonflow
# Exemplo SQLite (dev local rápido): sqlite+aiosqlite:///./salonflow.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salonflow

# Configuração de Segurança JWT
SECRET_KEY=sua_chave_secreta_super_segura_aqui_para_desenvolvimento_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Horário de Funcionamento do Salão (Formato HH:MM)
SALON_OPEN_TIME=08:00
SALON_CLOSE_TIME=18:00

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:4321
